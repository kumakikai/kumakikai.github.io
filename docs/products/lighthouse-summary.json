  "criticalFindings": [],
  "resolvedFindings": [
    {
      "id": "lcp-lazy-loaded",
      "finding": "The Product Hero screenshots were marked loading=lazy despite appearing in the initial viewport. The selected LCP was screenshot 2 at y=282px on desktop and screenshot 1 at y=635px on mobile.",
      "change": "Root changed the two Product Hero screenshots to loading=eager. Home and below-fold Product stories retain lazy loading.",
      "verification": "The final lcp-lazy-loaded audit passes for both modes; initial-document discoverability is true. No claim of measured speed improvement is made from single-run timing differences."
    }
  ],
  "nonBlockingObservations": [
    {
      "id": "local-server-cache-and-compression",
      "assessment": "The local HTTP server has no text compression and no cache TTL. Lighthouse reports approximately 60 KiB text compression savings and missing asset cache lifetimes. These are local-server observations, not verified GitHub Pages production defects."
    },
    {
      "id": "image-sizing-and-retina",
      "assessment": "Lighthouse suggests smaller image dimensions, including the below-fold 1120px PDF story on mobile. Existing srcset supports Retina: a 336 CSS-pixel image at emulated DPR 1.75 needs about 588 physical pixels, so the browser selects 1120 over 560. An intermediate rendition could reduce bytes but is not necessary for this task; do not remove Retina support just to satisfy a 1x size estimate."
    },
    {
      "id": "lcp-priority-hint",
      "assessment": "The desktop LCP may be the second Hero image, which has no fetchpriority=high. Eager loading and initial-document discovery pass; the optional priority-hint opportunity is recorded without adding competing high-priority images."
    },
    {
      "id": "css-blocking",
      "assessment": "One same-origin stylesheet is render-blocking. Latest Desktop scores are 100/100/100/100; Mobile scores are 100/100/100/100. No additional CSS/JS architecture changes are proposed."
    },
    {
      "id": "single-run-timing-variation",
      "assessment": "Single-run measurements are retained across all three stages. Small timing or one-point score changes do not establish a causal regression or improvement. The targeted lazy-LCP audit passes after the eager-Hero change and remains passing in the final CSS build."
    }
  ],
  "lazyLoadingAssessment": {
    "initialViewport": "Baseline lazy warning was genuine and limited to Product Hero screenshots, not a broken-image or after-scroll false positive.",
    "belowFold": "The PDF story at approximately y=3234px appears among fetched resources and retains loading=lazy. Chrome distance-based loading and Lighthouse gathering can fetch below-fold images; the precise trigger was not separately instrumented here. It was not the LCP target, so this is not a reason to remove lazy loading from the story.",
    "screenshots": "Report screenshots and full-page gathering can cause below-fold image requests after initial load; these do not prove eager initial loading."
  },
  "limitations": [
    "These are local, single-run lab measurements. They do not measure GitHub Pages CDN behavior, real-device performance, field Core Web Vitals or all Product pages.",
    "All three stages of raw JSON/HTML are stored under ignored artifacts/products/lighthouse for reproducibility; this committed summary retains metrics, selected diagnostics and file hashes."
  ],
